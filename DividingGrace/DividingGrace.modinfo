<?xml version="1.0" encoding="utf-8"?>
<Mod id="864ad063-f515-40ad-9329-db8cbb118bc7" version="1.1">
  <Properties>
    <Name>Dividing Grace（推恩令）</Name>
    <Description>
    仅限风云变幻。人类主要文明可生产「推恩令」项目。完工时，可夷平的城市会被撤销，人口均分给本文明其他已保留的城市，余数优先分给人口较少的城市。若无法执行，原城保留并在开始下一项生产时收回一半项目成本（向下取整）。
    Gathering Storm only. Human major civilizations can run the Dividing Grace project. On completion, a city that can be razed is removed and its population is divided equally among the civilization’s other kept cities. Remainders go to the least populous cities first. If the project cannot take effect, the city remains and recovers half of the project cost, rounded down, when it starts its next production.
    </Description>
    <Teaser>
    人类主要文明可用城市项目撤销符合条件的城市，并将人口分给其他城市。
    Human major civilizations can use a city project to remove an eligible city and redistribute its population.
    </Teaser>
    <Authors>ApprenTice</Authors>
    <Created>1795251198</Created>
    <AffectsSavedGames>1</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
  </Properties>

  <ActionCriteria>
    <Criteria id="DividingGrace_GatheringStorm">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
  </ActionCriteria>

  <InGameActions>
    <UpdateDatabase id="DividingGrace_Database" criteria="DividingGrace_GatheringStorm">
      <File>Gameplay/DividingGrace_Projects.sql</File>
    </UpdateDatabase>
    <UpdateText id="DividingGrace_Text" criteria="DividingGrace_GatheringStorm">
      <File>Gameplay/DividingGrace_Localization.sql</File>
    </UpdateText>
    <ImportFiles id="DividingGrace_IconTextures" criteria="DividingGrace_GatheringStorm">
      <File>UI/Icons/DividingGrace_Project30.dds</File>
      <File>UI/Icons/DividingGrace_Project32.dds</File>
      <File>UI/Icons/DividingGrace_Project38.dds</File>
      <File>UI/Icons/DividingGrace_Project50.dds</File>
      <File>UI/Icons/DividingGrace_Project70.dds</File>
      <File>UI/Icons/DividingGrace_Project80.dds</File>
      <File>UI/Icons/DividingGrace_Project256.dds</File>
    </ImportFiles>
    <UpdateIcons id="DividingGrace_Icons" criteria="DividingGrace_GatheringStorm">
      <File>UI/DividingGrace_Icons.sql</File>
    </UpdateIcons>
    <AddGameplayScripts id="DividingGrace_Gameplay" criteria="DividingGrace_GatheringStorm">
      <File>Gameplay/DividingGrace_Gameplay.lua</File>
    </AddGameplayScripts>
    <AddUserInterfaces id="DividingGrace_Completion" criteria="DividingGrace_GatheringStorm">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>UI/DividingGrace_Completion.xml</File>
    </AddUserInterfaces>
  </InGameActions>

  <Files>
    <File>Gameplay/DividingGrace_Projects.sql</File>
    <File>Gameplay/DividingGrace_Localization.sql</File>
    <File>Gameplay/DividingGrace_Gameplay.lua</File>
    <File>UI/DividingGrace_Completion.lua</File>
    <File>UI/DividingGrace_Completion.xml</File>
    <File>UI/DividingGrace_Icons.sql</File>
    <File>UI/Icons/DividingGrace_Project30.dds</File>
    <File>UI/Icons/DividingGrace_Project32.dds</File>
    <File>UI/Icons/DividingGrace_Project38.dds</File>
    <File>UI/Icons/DividingGrace_Project50.dds</File>
    <File>UI/Icons/DividingGrace_Project70.dds</File>
    <File>UI/Icons/DividingGrace_Project80.dds</File>
    <File>UI/Icons/DividingGrace_Project256.dds</File>
  </Files>
</Mod>
