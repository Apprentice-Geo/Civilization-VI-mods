<?xml version="1.0" encoding="utf-8"?>
<Mod id="ebe32804-8077-421c-a588-5b549de89995" version="1">
  <Properties>
    <Name>Raze Original Capital（夷平原始首都）</Name>
    <Description>
    通过修改全局配置，可夷平任意城市，对人类玩家和AI都生效。
    By modifying the global configuration, any city can be razed, affecting both human players and AI.
    </Description>
    <Created>1769623691</Created>
    <Teaser>
    允许夷平原始首都。
    Allow razing the original capital.
    </Teaser>
    <Authors>ApprenTice</Authors>
    <AffectsSavedGames>1</AffectsSavedGames>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <UpdateDatabase id="RazeOriginalCapital">
      <File>RazeOriginalCapital.sql</File>
    </UpdateDatabase>
  </InGameActions>
  <Files>
    <File>RazeOriginalCapital.sql</File>
  </Files>
</Mod>
