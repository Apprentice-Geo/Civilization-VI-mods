<?xml version="1.0" encoding="utf-8"?>
<Mod id="7e6dfc8c-a7a4-4d1b-a96e-df7a24d70445" version="7.0">
  <Properties>
    <Name>People's War（人民战争）</Name>
    <Description>
    仅限风云变幻。效果适用于人类主要文明、AI主要文明和城邦。帝国总人口从1人口起每10人口获得+1普通与宗教战斗力，最高+100。
    单城每满2人口获得+1远程攻击和+1外防御，100人口时各封顶+50。反间谍从1人口起每5人口增加1级，96人口时封顶+20级。
    征服城市人口不会损失。
    Gathering Storm only. Applies to human and AI major civilizations and city-states. Starting at 1 population, gain +1 normal and religious combat strength per 10 total population, capped at +100.
    Each city gains +1 ranged strike and +1 outer defense at 2 population and every 2 population thereafter, capped at +50 each at 100 population. Starting at 1 population, each city gains 1 counter-spy level per 5 population, capped at +20 at 96 population.
    Conquered cities lose no population.
    </Description>
    <Teaser>
    按人口强化人类文明、AI文明和城邦的单位与城市。
    Population strengthens units and cities for human and AI civilizations and city-states.
    </Teaser>
    <Authors>ApprenTice</Authors>
    <Created>1783958400</Created>
    <AffectsSavedGames>1</AffectsSavedGames>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>

  <ActionCriteria>
    <!-- 检查风云变幻规则集 决定后续改动是否执行 -->
    <Criteria id="PeoplesWar_GatheringStorm">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
  </ActionCriteria>

  <InGameActions>
    <UpdateDatabase id="PeoplesWar_Database" criteria="PeoplesWar_GatheringStorm">
      <File>Gameplay/PeoplesWar_Abilities.sql</File>
      <File>Gameplay/PeoplesWar_CityEffects.sql</File>
    </UpdateDatabase>
    <UpdateText id="PeoplesWar_Text" criteria="PeoplesWar_GatheringStorm">
      <File>Gameplay/PeoplesWar_Localization.sql</File>
    </UpdateText>
    <AddGameplayScripts id="PeoplesWar_Gameplay" criteria="PeoplesWar_GatheringStorm">
      <File>Gameplay/PeoplesWar_Gameplay.lua</File>
    </AddGameplayScripts>
  </InGameActions>

  <Files>
    <File>Gameplay/PeoplesWar_Abilities.sql</File>
    <File>Gameplay/PeoplesWar_CityEffects.sql</File>
    <File>Gameplay/PeoplesWar_Localization.sql</File>
    <File>Gameplay/PeoplesWar_Gameplay.lua</File>
  </Files>
</Mod>
