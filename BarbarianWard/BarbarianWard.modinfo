<Mod id="6b2b18ed-8c5d-48c2-ab04-4bc7db5885bf" version="1">
  <Properties>
    <Name>Barbarian Ward（蛮族退散）</Name>
    <Description>
    人类战斗单位与蛮族单位战斗时获得99战斗力增益。
    Human combat units gain a 99 advantage when combating barbarian units.
    </Description>
    <Created>1772200031</Created>
    <Teaser>
    +99对战蛮族优势
    +99 Advantage vs. Barbarians
    </Teaser>
    <Authors>ApprenTice</Authors>
    <AffectsSavedGames>1</AffectsSavedGames>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <UpdateDatabase id="BarbarianWard">
      <File>BarbarianWard.sql</File>
    </UpdateDatabase>
  </InGameActions>
  <Files>
    <File>BarbarianWard.sql</File>
  </Files>
</Mod>
